---
/** Large statement heading plus optional body, used by the simple pages. */
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div class="flex flex-col gap-8 lg:pt-65">
  <h1
    class="max-w-4xl text-5xl leading-[1.1] font-medium tracking-tight text-balance md:text-6xl"
  >
    {title}
  </h1>
  <slot />
</div>
