---
import Rule from "../components/rule.astro";
import Base from "../layouts/base.astro";

interface Entry {
  readonly name: string;
  readonly detail: string;
  readonly year: string;
}

interface Group {
  readonly label: string;
  readonly entries: readonly Entry[];
}

const now: readonly Entry[] = [
  { name: "Celtra", detail: "Frontend Validation", year: "2026" },
  { name: "ADC Systems", detail: "Design Engineer", year: "2025" },
  { name: "DragonHack", detail: "Partnerships", year: "2024" },
  { name: "Triglav", detail: "AI Product Engineer", year: "2024" },
  { name: "Creatim", detail: "Frontend Developer Intern", year: "2022" },
];

const groups: readonly Group[] = [
  {
    label: "Hackathons",
    entries: [
      {
        name: "DragonHack",
        detail: "Won the DevRev and zerodays challenges",
        year: "2026",
      },
      { name: "Startup Weekend", detail: "1st place, VitStaff", year: "2026" },
      { name: "Triglav Hackathon", detail: "1st place", year: "2024" },
    ],
  },
  {
    label: "School",
    entries: [
      {
        name: "School of Economics and Business",
        detail: "Entrepreneurship, 10/10 thesis",
        year: "2026",
      },
      { name: "Media High School Radovljica", detail: "Media", year: "2023" },
    ],
  },
  {
    label: "Toolkit",
    entries: [
      { name: "Build", detail: "TypeScript, Python, Go (basics)", year: "" },
      { name: "Design", detail: "Figma, Photoshop, Illustrator", year: "" },
    ],
  },
  {
    label: "Languages",
    entries: [
      { name: "Slovenian", detail: "Native", year: "" },
      { name: "English", detail: "Working proficiency", year: "" },
    ],
  },
];

const pad = (index: number) => String(index + 1).padStart(2, "0");
---

<Base
  title="About — Jan Arnež"
  description="Jan Arnež: entrepreneurship grad who builds software and AI products."
>
  <div class="flex flex-col gap-8 lg:pt-42 xl:grid xl:grid-cols-2">
    <h1 class="text-5xl leading-[1.1] font-semibold tracking-tight md:text-6xl">
      <em class="text-primary">Product-driven</em>. I can design, build and run
      the numbers
    </h1>
    <div class="flex max-w-xl flex-col gap-5 self-end text-lg leading-relaxed text-pretty text-muted-foreground">
      <p>
        I'm Jan, from near Kranj, Slovenia. I studied entrepreneurship, but I
        spent most of those years writing code. So I think product first and
        don't hand it off between roles: I design it, build it and work out the
        economics that make it a business.
      </p>
      <p>
        What I enjoy most is the step from an idea to something people can
        actually use. I like building AI products, working out why some
        companies grow so fast, and talking to the people who will use the
        thing. My thesis was about exactly that: how Lovable grew by building in
        public. It got a 10/10.
      </p>
      <p>
        Outside work you'll find me at hackathons. Late nights, a few wins and a
        lot of lessons.
      </p>
      <p class="text-foreground">
        Looking for my next thing in product, AI or an early-stage startup. If
        you're building something,{" "}
        <a
          href="mailto:arnezjan8@gmail.com"
          class="underline decoration-foreground/30 underline-offset-4 transition-colors hover:text-primary hover:decoration-primary"
        >
          say hi
        </a>
        .
      </p>
    </div>
  </div>

  <Rule />

  <section class="flex flex-col gap-8 xl:grid xl:grid-cols-2">
    <h2 class="text-sm text-muted-foreground uppercase">Now</h2>
    <ul class="flex flex-col gap-y-2">
      {now.map((item) => (
        <li class="grid grid-cols-6 gap-x-8 text-muted-foreground">
          <span class="col-span-2 text-foreground">{item.name}</span>
          <span class="col-span-3">{item.detail}</span>
          <span class="text-right">{item.year}</span>
        </li>
      ))}
    </ul>
  </section>

  {groups.map((group, index) => (
    <>
      <Rule />
      <section class="flex flex-col gap-8 xl:grid xl:grid-cols-2">
        <h2 class="text-sm text-muted-foreground uppercase">
          {pad(index)} / {group.label}
        </h2>
        <ul class="flex flex-col gap-y-2">
          {group.entries.map((item) => (
            <li class="grid grid-cols-6 gap-x-8 text-muted-foreground">
              <span class="col-span-2 text-foreground">{item.name}</span>
              <span
                class:list={[item.year === "" ? "col-span-4" : "col-span-3"]}
              >
                {item.detail}
              </span>
              {item.year !== "" && <span class="text-right">{item.year}</span>}
            </li>
          ))}
        </ul>
      </section>
    </>
  ))}
</Base>
